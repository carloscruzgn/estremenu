0,"again":[],"neg":false},"06144":{"cls":"prob","wave":0,"again":[],"neg":false},"06145":{"cls":"prob","wave":0,"again":[],"neg":false},"06146":{"cls":"prob","wave":0,"again":[],"neg":false},"06149":{"cls":"prob","wave":0,"again":[],"neg":false},"06150":{"cls":"prob","wave":0,"again":[],"neg":false},"06151":{"cls":"prob","wave":0,"again":[],"neg":false},"06152":{"cls":"prob","wave":0,"again":[],"neg":false},"06153":{"cls":"prob","wave":0,"again":[],"neg":false},"06155":{"cls":"prob","wave":0,"again":[],"neg":false},"06156":{"cls":"prob","wave":0,"again":[],"neg":false},"06157":{"cls":"prob","wave":0,"again":[],"neg":false},"06158":{"cls":"prob","wave":0,"again":[],"neg":false},"06159":{"cls":"prob","wave":0,"again":[],"neg":false},"06160":{"cls":"prob","wave":0,"again":[],"neg":false},"06161":{"cls":"prob","wave":0,"again":[],"neg":false},"06162":{"cls":"prob","wave":0,"again":[],"neg":false},"06901":{"cls":"prob","wave":0,"again":[],"neg":false},"06902":{"cls":"prob","wave":0,"again":[],"neg":false},"06903":{"cls":"prob","wave":0,"again":[],"neg":false}},"pagina":{"_fuente":"Apuntes del alumnado, página M01 (Google Doc Apuntes_alumnado_estremenu, 05/10/2026), con la h volada de 00-CRITERIOS-DE-TRANSCRIPCION","apartados":[["Qué es","La misma palabra en masculino y en femenino nombra dos cosas de distinto tamaño, o dos cosas parecidas: chozu es la choza pequeña y choza la grande; cuestu la cuesta pequeña; sierru un cerro y sierra la de verdad; corchu es el corcho o la colmena y corcha la plancha de corcho; cuencu el mortero de madera y cuenca otro; cuernu el del animal y cuerna el vaso de cuerno o el recipiente de la piedra de afilar; bañu y baña, botiju y botija, campanillu y campanilla. Y a veces al revés: liendru es el bieldo y liendra el bieldo grande. Lo mismo queda en los nombres del campo: Los Cabezos, Los Cuestos."],["De dónde viene","De todas partes: el castellano lo hace en cesto y cesta, jarro y jarra, huerto y huerta. Aquí se ha estirado a muchas más palabras. Y una pareja es solo nuestra: yugu es el yugo de los bueyes y yuga el de las caballerías, y eso no lo ha encontrado nadie más al norte."],["Qué encontraron","En 1912 Krüger apuntó de pasada topa en Pozuelo y Villanueva frente a topo en Torre de Don Miguel, y cuchilla en Montehermoso, sin preguntar más. Hacia 1970 Cummins reunió diecisiete parejas en sus trece pueblos y descubrió otra cosa que da mucho juego: las palabras femeninas que se dicen de un hombre para pintarle el carácter llevan artículo masculino sin cambiar de terminación, un tarea, un prosa, un manu de yerru. Hacia 1996 no se preguntó."],["Cómo está","Todavía se oye, mientras siga la cosa nombrada. Donde no hay bieldo no hay liendra. Trae parejas de tu casa: la lista de Cummins se puede alargar."]],"estado":"Todavía se oye","origenes":["De todas partes"],"ejemplos":[{"base":"choz","antes":"a","despues":"u"},{"base":"cuest","antes":"a","despues":"u"},{"base":"sierr","antes":"a","despues":"u"}]}}