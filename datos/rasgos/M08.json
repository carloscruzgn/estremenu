in":[],"neg":false},"06155":{"cls":"prob","wave":0,"again":[],"neg":false},"06156":{"cls":"prob","wave":0,"again":[],"neg":false},"06157":{"cls":"prob","wave":0,"again":[],"neg":false},"06158":{"cls":"prob","wave":0,"again":[],"neg":false},"06159":{"cls":"prob","wave":0,"again":[],"neg":false},"06160":{"cls":"prob","wave":0,"again":[],"neg":false},"06161":{"cls":"prob","wave":0,"again":[],"neg":false},"06162":{"cls":"prob","wave":0,"again":[],"neg":false},"06901":{"cls":"prob","wave":0,"again":[],"neg":false},"06902":{"cls":"prob","wave":0,"again":[],"neg":false},"06903":{"cls":"prob","wave":0,"again":[],"neg":false}},"pagina":{"_fuente":"Apuntes del alumnado, página M08 (Google Doc Apuntes_alumnado_estremenu, 05/10/2026), con la h volada de 00-CRITERIOS-DE-TRANSCRIPCION","apartados":[["Qué es","Varias maneras propias de usar los pronombres. Se pone se detrás: me se cayó, te se olvida, li se muriú. Se dice mos, mosotrus, muestru, sus por 'nos', 'nosotros', 'nuestro', 'os': mos vamos, sentaisus, callaisus. Y detrás del verbo, el pronombre cierra la vocal: comelu, tenelu, jadelu, se li dici, lu jacin."],["De dónde viene","Mezcla. Me se y mos son cosas que se dicen en toda España cuando se habla sin mirar la gramática, y Cummins avisa de que son «vulgares más bien que dialectales». Lo de comelu y se li dici es nuestro: es el cierre de las vocales (V01) aplicado a los pronombres."],["Qué encontraron","En 1912 Krüger apuntó mos en Guijo de Galisteo y Montehermoso, nusotrus en Ahigal, Guijo de Galisteo y Ceclavín, y formas como dezillu en Villa del Campo y julgallu en Guijo de Galisteo. Hacia 1970 Cummins recogió comelu, se li poni, lu jacin en Coria, me se fue y me se muriú en Casillas de Coria, y ya entonces mos y mosotrus «se van limitando cada vez más al habla rústica». Hacia 1996 no se preguntó. Un vecino de Ahigal dio en 2002 una explicación bonita de por qué mos sobrevive: cuando la s se aspira, no trai uvas y mos trai uvas se distinguen sin esfuerzo, y con nos no."],["Cómo está","Se va perdiendo."]],"estado":"Se va perdiendo","origenes":[],"ejemplos":[{"partes":[{"antes":"n","despues":"m","rasgo":true},"os vamos"]},{"partes":[{"antes":"se te","despues":"te se","rasgo":true}," olvida"]},{"partes":[{"antes":"n","despues":"m","rasgo":true},"osotr",{"antes":"o","despues":"u"},"s"]},{"partes":["come",{"antes":"r","despues":""},"l",{"antes":"o","despues":"u","rasgo":true}]}],"_ejemplos":"Ejemplos de la cabecera de la web, elegidos por Carlos el 19/10/2026 de la página de los apuntes; la palabra pasa entera del castellano a la nuestra y solo se subraya el cambio del rasgo. El reel lleva los suyos en su fichero de rasgo"}}