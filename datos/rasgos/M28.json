"wave":0,"again":[],"neg":false},"06144":{"cls":"prob","wave":0,"again":[],"neg":false},"06145":{"cls":"prob","wave":0,"again":[],"neg":false},"06146":{"cls":"prob","wave":0,"again":[],"neg":false},"06149":{"cls":"prob","wave":0,"again":[],"neg":false},"06150":{"cls":"prob","wave":0,"again":[],"neg":false},"06151":{"cls":"prob","wave":0,"again":[],"neg":false},"06152":{"cls":"prob","wave":0,"again":[],"neg":false},"06153":{"cls":"prob","wave":0,"again":[],"neg":false},"06155":{"cls":"prob","wave":0,"again":[],"neg":false},"06156":{"cls":"prob","wave":0,"again":[],"neg":false},"06157":{"cls":"prob","wave":0,"again":[],"neg":false},"06158":{"cls":"prob","wave":0,"again":[],"neg":false},"06159":{"cls":"prob","wave":0,"again":[],"neg":false},"06160":{"cls":"prob","wave":0,"again":[],"neg":false},"06161":{"cls":"prob","wave":0,"again":[],"neg":false},"06162":{"cls":"prob","wave":0,"again":[],"neg":false},"06901":{"cls":"prob","wave":0,"again":[],"neg":false},"06902":{"cls":"prob","wave":0,"again":[],"neg":false},"06903":{"cls":"prob","wave":0,"again":[],"neg":false}},"pagina":{"_fuente":"Apuntes del alumnado, página M28 (Google Doc Apuntes_alumnado_estremenu, 05/10/2026), con la h volada de 00-CRITERIOS-DE-TRANSCRIPCION","apartados":[["Qué es","Unos cuantos verbos significan aquí otra cosa que en el castellano de la escuela: caer es tirar o derramar, caí el caldu al suelu, esa casa la van a cael; quedar es dejar u olvidar, me queé laʰ llaviʰ en casa, le quedaron el nombri; entrar es meter, entru loʰ lechonis en la corralá; coger es caber, aquí no cogemus; sobrar es dejar de sobra, has sobráu muchu; y soñar lleva siempre se, me soñé contigo. Con el género pasa parecido: la calor, la aceiti, la puenti, la pus, el reúma."],["De dónde viene","Mezcla. Quedar por dejar está escrito desde el siglo XVI y hay quien lo cuenta como leonés; los demás se oyen en muchas partes de España cuando se habla sin mirar la gramática. Un estudioso de aquí dijo que estos verbos, junto con el diminutivo en -inu, son casi lo único de la gramática que es de verdad extremeño."],["Qué encontraron","De 1912 no hay noticia: Krüger no preguntó por verbos. Hacia 1970 Cummins recogió «muchos casos» de quedar, crecer y caer usados así: allí queaban el milu en Casillas de Coria, ba queandu un lomitu en Huélaga, esa casa la van a cael y para crecel la cera en Coria; y en Montehermoso la mejol aceiti que hay. Hacia 1996 no se preguntó. En 2002, en Guijo de Galisteo, seguían los cuatro, caí el caldu, entru loʰ lechonis; y en Ahigal un vecino avisaba de que allí se dice quedar y sobrar pero no entrar por meter ni caer por tirar: cada pueblo tiene su reparto."],["Cómo está","Todavía se oye. Son de los que más corrige la escuela y de los que más cuesta quitarse, porque no suenan a pueblo: suenan a normal. ¿Cuáles dices tú?"]],"estado":"Todavía se oye","origenes":[],"ejemplos":[{"base":"","antes":"el","despues":"la","cola":" calor"},{"base":"me ","antes":"dejé","despues":"queé","cola":""}]}}