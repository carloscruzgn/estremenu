e},"10208":{"cls":"part","wave":0,"again":[],"neg":false},"10210":{"cls":"prob","wave":0,"again":[],"neg":false},"10211":{"cls":"reg","wave":1,"again":[1],"neg":false},"10212":{"cls":"base","wave":0,"again":[],"neg":true},"10214":{"cls":"prob","wave":0,"again":[],"neg":false},"10215":{"cls":"prob","wave":0,"again":[],"neg":false},"10216":{"cls":"reg","wave":1,"again":[1,2],"neg":false},"10218":{"cls":"reg","wave":1,"again":[1],"neg":false},"10902":{"cls":"prob","wave":0,"again":[],"neg":false},"10903":{"cls":"prob","wave":0,"again":[],"neg":false},"37002":{"cls":"part","wave":0,"again":[],"neg":false},"37037":{"cls":"part","wave":0,"again":[],"neg":false},"37157":{"cls":"part","wave":0,"again":[],"neg":false},"37181":{"cls":"part","wave":0,"again":[],"neg":false},"37199":{"cls":"part","wave":0,"again":[],"neg":false},"37221":{"cls":"reg","wave":2,"again":[2,3],"neg":false},"37234":{"cls":"reg","wave":3,"again":[3],"neg":false},"37245":{"cls":"reg","wave":3,"again":[3],"neg":false},"37269":{"cls":"reg","wave":3,"again":[3],"neg":false},"37303":{"cls":"out","wave":0,"again":[],"neg":false},"37306":{"cls":"part","wave":0,"again":[],"neg":false},"37307":{"cls":"part","wave":0,"again":[],"neg":false},"37371":{"cls":"reg","wave":3,"again":[3],"neg":false},"37378":{"cls":"part","wave":0,"again":[],"neg":false}},"pagina":{"_fuente":"Apuntes del alumnado, página V01 (Google Doc Apuntes_alumnado_estremenu, 05/10/2026)","apartados":[["Qué es","La o y la e del final de palabra, cuando no llevan el golpe de voz, se pronuncian u e i: libru, tiempu, caballu, grandi, nochi, genti, setiembri. Pasa también con los pronombres: se li poni, lu jacin. No cambia la vocal cuando lleva el acento: café sigue siendo café. Es el rasgo que más nos delata fuera de casa, y el primero que se aprende a esconder."],["De dónde viene","Leonés. Lo trajeron los repobladores del reino de León hace ochocientos años y sigue vivo en Asturias y en León. En el sur de Extremadura apenas se oye."],["Qué encontraron","En 1912, Krüger lo oyó en casi todos los pueblos y casi siempre, pero ya notó dos cosas: que en algunos —Pozuelo de Zarzón, Gata, Casar de Palomero— la gente decía ya -o y -e, y que en todas partes, al empezar a hablar con él, le daban primero la forma fina y luego se les escapaba la de verdad. Hacia 1970, Cummins lo tuvo por «uno de los rasgos más característicos del habla de Coria y de sus cercanías», algo menos fuerte en la ciudad que en los pueblos, y apuntó que los jóvenes lo sentían ya como cosa de incultos. Su mejor ejemplo fue un chiquillo de doce años de Montehermoso que lo hacía sin cortarse porque no iba a la escuela. Hacia 1996, González Salgado lo encontró «solo en boca de los hablantes de edad avanzada»: bastante en Guijo de Galisteo, Casar de Palomero y Ahigal, y de vez en cuando, en palabras sueltas, en Portaje, Ceclavín, Garrovillas y Casas de Don Gómez. En los poemas de Gabriel y Galán está por todas partes: ondi, alanti, hombris, gustu."],["Cómo está","Se va perdiendo. Casi todos los mayores lo dicen o lo han dicho, y casi ningún joven lo dice."]],"estado":"Se va perdiendo","origen":"Leonés"}}